{
  "name": "last-layer-lab",
  "productName": "Last Layer Lab",
  "version": "3.0.2",
  "description": "3x3 speedcubing algorithm trainer",
  "main": "bundle/main.js",
  "author": "greganator2001",
  "license": "MIT",
  "repository": "https://github.com/greganator2001-jpg/Cubing",
  "scripts": {
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win nsis --x64",
    "release": "npm run bundle && electron-builder --win nsis --x64 --publish always",
    "bundle": "esbuild main.js --bundle --platform=node --target=node20 --external:electron --outfile=bundle/main.js"
  },
  "build": {
    "appId": "com.greganator.lastlayerlab",
    "productName": "Last Layer Lab",
    "files": [
      "bundle/**/*",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Last Layer Lab",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "greganator2001-jpg",
        "repo": "Cubing",
        "releaseType": "release"
      }
    ],
    "asar": false
  },
  "devDependencies": {
    "cubejs": "^1.3.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.24.2"
  }
}
